# dunst config — minimal square/compact for mediacard.sh
# See dunst(5) for all options

[global]
    ### Display ###
    monitor = 0
    follow = none

    ### Geometry — square-ish, compact ###
    width = 360
    height = (0, 180)
    origin = top-right
    offset = (16, 56)

    scale = 0
    notification_limit = 3

    ### Progress bar — DISABLED (using custom segmented bar in mediacard.sh) ###
    progress_bar = false

    icon_corner_radius = 0
    icon_corners = all

    indicate_hidden = no

    transparency = 20
    sticky_history = no

    separator_height = 0
    padding = 8
    horizontal_padding = 12
    text_icon_padding = 10

    frame_width = 2
    frame_color = "#5c6354"

    gap_size = 8
    separator_color = frame

    # NOTE: Blur requires a compositor (picom) with blur backend enabled
    # dunst itself doesn't render blur; compositor handles window blur
    # Add to picom.conf: blur-background = true; blur-method = "dual_kawase"; blur-strength = 5

    sort = no

    ### Text ###
    font = "JetBrains Mono 10"
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = -1
    ellipsize = end
    ignore_newline = no

    stack_duplicates = true
    hide_duplicate_count = true
    show_indicators = no

    ### Icons ###
    icon_theme = "Adwaita"
    icon_path = "/usr/share/icons/Adwaita:/usr/share/icons/hicolor"
    icon_position = left
    max_icon_size = 80
    

    ### Colors — Cyberpunk/Teal theme (matches waybar demo) ###
    # low
    background = "#1a1d16"
    foreground = "#d1d8ca"
    # normal
    background = "#1a1d16"
    foreground = "#d1d8ca"
    # critical
    background = "#1a1d16"
    foreground = "#d1d8ca"

    ### Timeout (mediacard.sh sends -t 2000, this is fallback) ###
    [urgency_low]
        timeout = 2
    [urgency_normal]
        timeout = 2
    [urgency_critical]
        timeout = 5

    ### Rules for mediacard.sh (appname="Now Playing", stack_tag="media") ###
    [media_card]
        appname = "Now Playing"
        format = "<b>%s</b>\n%b"
        icon_position = left
        max_icon_size = 80

    [media_overdrive]
        appname = "Now Playing"
        category = "overdrive"
        format = "<b>%s</b>\n<span foreground='#f38ba8'>%b</span>"
        icon_position = left
        max_icon_size = 80

    ### Generic rules ###
    [volume]
        appname = "*Volume*"
        format = "<b>%s</b>\n%b"
        icon_position = left
        max_icon_size = 48

    [transient]
        match_transient = yes
        set_transient = no