/* interval between updates (in ms) */
const unsigned int interval = 1000;

/* text to show if no value can be retrieved */
static const char unknown_str[] = "";

/* maximum output string length */
#define MAXLEN 2048

/*
 * Cấu hình đồng bộ màu với bar.sh cũ (bar_themes/wal - tông tím):
 *   black=#1d0e25  green=#352b8f  white=#d5c3df  grey=#5e5463
 *   blue=#a342d7   red=#652886    teal=#c98cea   darkblue=#3673b5
 * Dùng status2d: ^c#HEX^ = fg, ^b#HEX^ = bg, ^d^ = reset.
 */
static const struct arg args[] = {
    /* function       format                          argument */
    /* package updates: đọc cache do updates-daemon.sh ghi */
    { run_command,   " %s ",                          "sh -c 'c=\"$HOME/.cache/dwm-updates\"; [ -f \"$c\" ] || printf 0 > \"$c\"; n=$(cat \"$c\"); if [ \"$n\" -gt 0 ]; then echo \"^c#d5c3df^^b#5e5463^   $n ^d^\"; else echo \"^c#352b8f^   ^d^\"; fi'" },
    /* CPU % */
    { cpu_perc,      " ^c#1d0e25^ ^b#352b8f^ CPU ^c#d5c3df^ ^b#5e5463^ %s%% ^d^ ", NULL },
    /* CPU temperature (x86_pkg_temp) */
    { temp,          " ^c#1d0e25^ ^b#c98cea^ 󰔄 ^c#d5c3df^ ^b#5e5463^ %s°C ^d^ ", "/sys/class/thermal/thermal_zone4/temp" },
    /* memory used */
    { ram_used,      " ^c#652886^  ^c#d5c3df^ %s ^d^", NULL },
    /* network: wifi SSID > wired > disconnected */
    { run_command,   " ^c#1d0e25^ ^b#a342d7^ %s ^d^", "sh -c 's=$(iwgetid -r 2>/dev/null); if [ -n \"$s\" ]; then echo \"󰤨 $s\"; elif ip -4 addr show enp8s0 2>/dev/null | grep -q \"inet \"; then echo \"󰤨 Wired\"; else echo \"󰤭\"; fi'" },
    /* clock */
    { datetime,      " ^c#1d0e25^ ^b#3673b5^ 󱑆 ^c#1d0e25^ ^b#a342d7^ %s  ^d^ ", "%a %d %b %H:%M" },
};
